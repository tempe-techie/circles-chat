# Local API server only (npm run dev:api). Vite dev proxies /api to production.
MYLOCALHOST=1

# Secret used to HMAC-hash user session keys before storing them in Datastore.
# Use a long random value (e.g. `openssl rand -hex 32`). In production, set this
# as a `SESSION_HMAC_SECRET` entry in the Datastore `EnvVar` collection instead.
SESSION_HMAC_SECRET=dev-only-change-me

